{
  "name": "amux",
  "version": "0.1.0",
  "description": "Agent Multiplexer (amux) — The tmux for AI Coding Agents. Seamlessly sync projects, handoff context, and share pitfall memories across Codex, Antigravity, Claude Code, and beyond.",
  "type": "module",
  "bin": {
    "amux": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "multiplexer",
    "tmux",
    "agent-harness",
    "context-engineering",
    "codex",
    "antigravity",
    "claude-code",
    "cursor",
    "mcp",
    "mcp-server",
    "handoff",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "commander": "^15.1.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
